set nocompatible
" Windows default codepage breaks UTF-8 fixtures (Korean in syntax.vader).
set encoding=utf-8
set fileencoding=utf-8
filetype off
let &runtimepath = expand('<sfile>:p:h:h') . ',' . &runtimepath
let s:vader = expand('<sfile>:p:h') . '/vendor/vader.vim'
if isdirectory(s:vader)
  let &runtimepath = s:vader . ',' . &runtimepath
endif
filetype plugin indent on
syntax enable
set shiftwidth=2
set expandtab
