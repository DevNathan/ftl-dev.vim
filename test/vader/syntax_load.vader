" coverage: syntax.load_clean
Execute (syntax/freemarker.vim sources with no E866/E475):
  new
  call setline(1, [
        \ '<#assign x = m1.now()?string("yyyy")/>',
        \ '<#assign y = x?substring(0,8)/>',
        \ '${x}',
        \ '<#-- c -->',
        \ '[#if true][/#if]',
        \ ])
  let v:errmsg = ''
  redir => g:ftl_msgs
  silent! setfiletype freemarker
  redir END
  AssertEqual 'freemarker', b:current_syntax
  Assert g:ftl_msgs !~# 'E866'
  Assert g:ftl_msgs !~# 'E475'
  Assert v:errmsg ==# ''
  syntax sync fromstart
  " full builtin word — NOT just '?s' ([\w] collection bug)
  " Use SyntaxAt (synstack prime); raw synID can be stale on Win Vim 9.2.
  let q = stridx(getline(1), '?string') + 1
  AssertEqual 'ftlBuiltin', SyntaxAt(1, q)
  let t = stridx(getline(1), '?string') + strlen('?string')
  AssertEqual 'ftlBuiltin', SyntaxAt(1, t)
  let sub = stridx(getline(2), '?substring') + 1
  AssertEqual 'ftlBuiltin', SyntaxAt(2, sub)
  let sub_end = stridx(getline(2), '?substring') + strlen('?substring')
  AssertEqual 'ftlBuiltin', SyntaxAt(2, sub_end)
  let a = stridx(getline(1), 'assign') + 1
  AssertEqual 'ftlDirKeyword', SyntaxAt(1, a)
  bwipe!
