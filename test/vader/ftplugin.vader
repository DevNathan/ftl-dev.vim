" coverage: ftplugin.auto_close_after_slash
" coverage: ftplugin.auto_close_after_slash_self
" Case 1: <#assign r = 10 / → insert >
Execute (after_slash self-close angle assign inserts >):
  new
  setfiletype freemarker
  call setline(1, '<#assign r = 10 /')
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  AssertEqual '>', ftl_dev#close#after_slash()
  set virtualedit&
  bwipe!

" coverage: ftplugin.auto_close_after_slash_self
" Case 1 square: [#assign / → insert ]
Execute (after_slash self-close square assign inserts ]):
  new
  setfiletype freemarker
  call setline(1, '[#assign /')
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  AssertEqual ']', ftl_dev#close#after_slash()
  set virtualedit&
  bwipe!

" coverage: ftplugin.auto_close_after_slash_self
Execute (after_slash self-close skips when > already follows):
  new
  setfiletype freemarker
  call setline(1, '<#assign  />')
  call cursor(1, strlen('<#assign  /') + 1)
  AssertEqual '', ftl_dev#close#after_slash()
  bwipe!

" coverage: ftplugin.auto_close_after_slash_self
Execute (imap / self-closes assign to />):
  new
  setfiletype freemarker
  call setline(1, '<#assign r = 10 ')
  call feedkeys("A/\<Esc>", 'xt')
  AssertEqual '<#assign r = 10 />', getline(1)
  bwipe!

  new
  setfiletype freemarker
  call setline(1, '[#assign ')
  call feedkeys("A/\<Esc>", 'xt')
  AssertEqual '[#assign /]', getline(1)
  bwipe!

" coverage: ftplugin.auto_close_after_slash
" coverage: ftplugin.auto_close_after_slash_ftl
" Case 2 same-line: append name+closer after `/`
Execute (after_slash mid-line </ appends #assign>):
  new
  setfiletype freemarker
  call setline(1, '<#assign><')
  call feedkeys("A/\<Esc>", 'xt')
  AssertEqual '<#assign></#assign>', getline(1)
  bwipe!

" coverage: ftplugin.auto_close_after_slash_ftl
Execute (imap </ after nested opens uses innermost):
  new
  setfiletype freemarker
  call setline(1, ['<#if x>', '<#list y as z>', '<'])
  call cursor(3, 1)
  call feedkeys("A/\<Esc>", 'xt')
  AssertEqual '</#list>', getline(3)
  bwipe!

" coverage: ftplugin.auto_close_after_slash_ftl
Execute (same-line <#if></ expands to </#if>):
  new
  setfiletype freemarker
  call setline(1, '<#if x><')
  call feedkeys("A/\<Esc>", 'xt')
  AssertEqual '<#if x></#if>', getline(1)
  bwipe!

" coverage: ftplugin.auto_close_after_slash
" coverage: ftplugin.auto_close_after_slash_indent
" AC6: alone on line rewrites indent to match opener
Execute (imap </ alone on line rewrites indent to opener):
  new
  setfiletype freemarker
  set virtualedit=onemore
  call setline(1, ['<#if x>', '  body', '    <'])
  call cursor(3, strlen(getline(3)) + 1)
  call feedkeys("a/\<Esc>", 'xt')
  set virtualedit&
  AssertEqual '<#if x>', getline(1)
  AssertEqual '  body', getline(2)
  AssertEqual '</#if>', getline(3)
  bwipe!

" coverage: ftplugin.auto_close_after_slash_indent
Execute (imap [/ alone on line uses nested opener indent):
  new
  setfiletype freemarker
  set virtualedit=onemore
  call setline(1, ['[#if a]', '  [#list xs as x]', '    item', '    ['])
  call cursor(4, strlen(getline(4)) + 1)
  call feedkeys("a/\<Esc>", 'xt')
  set virtualedit&
  AssertEqual '  [/#list]', getline(4)
  bwipe!

" coverage: ftplugin.auto_close_after_slash
Execute (after_slash respects g:ftl_dev_auto_close off):
  new
  setfiletype freemarker
  let g:ftl_dev_auto_close = 0
  call setline(1, '<#assign /')
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  AssertEqual '', ftl_dev#close#after_slash()
  unlet g:ftl_dev_auto_close
  set virtualedit&
  bwipe!
