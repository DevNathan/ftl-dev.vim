" coverage: ftplugin.guard
" coverage: ftplugin.commentstring
" coverage: ftplugin.comments
" coverage: ftplugin.matchpairs
" coverage: ftplugin.include
" coverage: ftplugin.includeexpr
" coverage: ftplugin.suffixesadd
" coverage: ftplugin.undo
Execute (ftplugin sets buffer options):
  new
  setfiletype freemarker
  AssertEqual &l:commentstring, ftl_dev#ft#expected_commentstring()
  Assert &l:comments =~# '<#--'
  Assert &l:matchpairs =~# '<:>'
  Assert &l:include =~# 'include'
  AssertEqual &l:suffixesadd, ftl_dev#ft#expected_suffixesadd()
  Assert !empty(b:undo_ftplugin)
  runtime ftplugin/freemarker.vim
  AssertEqual b:did_ftplugin, 1
  bwipe!

" coverage: ft.strip_quotes
Execute (includeexpr quote strip helper):
  AssertEqual ftl_dev#ft#strip_include_quotes('"lib.ftl"'), 'lib.ftl'
  AssertEqual ftl_dev#ft#strip_include_quotes("'lib.ftl'"), 'lib.ftl'
  AssertEqual ftl_dev#ft#strip_include_quotes('lib.ftl'), 'lib.ftl'

" coverage: ftplugin.imap_dollar
Execute (imap ${ inserts closing brace):
  new
  setfiletype freemarker
  call feedkeys('i${', 'x')
  Assert getline(1) =~# '${}'
  bwipe!

" coverage: ftplugin.match_words
" coverage: ft.match_words_helper
Execute (match_words when matchit is loaded):
  runtime! macros/matchit.vim
  new
  setfiletype freemarker
  Assert ftl_dev#ft#match_words_defined()
  Assert b:match_words =~# '<#if'
  bwipe!

" coverage: ftplugin.auto_close_parse
Execute (parse_pairable recognizes block opens):
  Assert !empty(ftl_dev#close#parse_pairable('<#attempt>'))
  Assert !empty(ftl_dev#close#parse_pairable('  <#if x>'))
  Assert empty(ftl_dev#close#parse_pairable('<#recover>'))
  Assert empty(ftl_dev#close#parse_pairable('<#assign x = 1>'))
  Assert !empty(ftl_dev#close#parse_pairable('<#assign x>'))

" coverage: ftplugin.auto_close_cr
" coverage: ftplugin.auto_close_cr_keys
Execute (cr() must not return Cmd literal — ships as text on old Vim):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, '<#attempt>')
  " Win32 Vim clamps cursor() past EOL unless virtualedit=onemore
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  let keys = ftl_dev#close#cr()
  set virtualedit&
  Assert keys !~? 'Cmd'
  Assert keys !~# 'ftl_dev#close'
  Assert keys =~# '</#attempt>'
  Assert keys =~# "\<CR>"
  bwipe!

" coverage: ftplugin.auto_close_cr
" AC5: unclosed open at EOL still inserts body + closer
Execute (insert-mode CR mapping closes attempt without Cmd spam):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  " Pre-seed open tag: typing '>' would trigger after_bracket same-line closer
  call setline(1, '<#attempt>')
  call feedkeys("A\<CR>\<Esc>", 'xt')
  Assert join(getline(1, '$'), "\n") !~? 'Cmd'
  Assert join(getline(1, '$'), "\n") !~# 'expand_cr'
  AssertEqual '<#attempt>', getline(1)
  AssertEqual '    ', getline(2)
  AssertEqual '</#attempt>', getline(3)
  AssertEqual 2, line('.')
  bwipe!

" coverage: ftplugin.auto_close_cr_same_line
" AC1: <#assign>|</#assign> Enter → open / indented blank / closer
Execute (CR between same-line assign pair splits with body indent):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, '<#assign></#assign>')
  call cursor(1, strlen('<#assign>') + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  AssertEqual '<#assign>', getline(1)
  AssertEqual '    ', getline(2)
  AssertEqual '</#assign>', getline(3)
  AssertEqual 3, line('$')
  AssertEqual 2, line('.')
  " After Esc, cursor rests on last indent char (not short of indent).
  AssertEqual 4, col('.')
  bwipe!

" coverage: ftplugin.auto_close_cr_same_line
" Nested same-line pair: body indent = opener indent + shiftwidth; closer aligns to opener.
Execute (CR between nested same-line assign keeps parent indent):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, '  <#assign></#assign>')
  call cursor(1, strlen('  <#assign>') + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  AssertEqual '  <#assign>', getline(1)
  AssertEqual '      ', getline(2)
  AssertEqual '  </#assign>', getline(3)
  AssertEqual 2, line('.')
  AssertEqual 6, col('.')
  bwipe!

" Nested under #if (screenshot case): closer must not fall to column 0
Execute (CR between assign pair nested under if aligns closer to assign):
  new
  setfiletype freemarker
  setlocal shiftwidth=2 expandtab
  call setline(1, ['<#if x>', '  <#-- c -->', '  <#assign></#assign>'])
  call cursor(3, strlen('  <#assign>') + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  AssertEqual '<#if x>', getline(1)
  AssertEqual '  <#-- c -->', getline(2)
  AssertEqual '  <#assign>', getline(3)
  AssertEqual '    ', getline(4)
  AssertEqual '  </#assign>', getline(5)
  AssertEqual 4, line('.')
  bwipe!

" coverage: ftplugin.auto_close_cr_same_line
" AC2: <#if> / [#list] same-line pairs
Execute (CR between same-line if and list pairs):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, '<#if x></#if>')
  call cursor(1, strlen('<#if x>') + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  AssertEqual '<#if x>', getline(1)
  AssertEqual '    ', getline(2)
  AssertEqual '</#if>', getline(3)
  AssertEqual 3, line('$')
  bwipe!

  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, '[#list xs as x][/#list]')
  call cursor(1, strlen('[#list xs as x]') + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  AssertEqual '[#list xs as x]', getline(1)
  AssertEqual '    ', getline(2)
  AssertEqual '[/#list]', getline(3)
  AssertEqual 3, line('$')
  bwipe!

" coverage: ftplugin.auto_close_cr_one_closer
" AC3: open + closer on next line, Enter at EOL → body indent, one closer
Execute (CR at EOL of open already closed below indents body only):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, ['<#attempt>', '</#attempt>'])
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  set virtualedit&
  AssertEqual '<#attempt>', getline(1)
  AssertEqual '    ', getline(2)
  AssertEqual '</#attempt>', getline(3)
  AssertEqual 3, line('$')
  AssertEqual 1, len(filter(getline(1, '$'), 'v:val =~# "</#attempt>"'))
  bwipe!

" Nested open already closed: body keeps opener indent + shiftwidth
Execute (CR at EOL of nested open already closed keeps parent indent):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, ['  <#attempt>', '  </#attempt>'])
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  set virtualedit&
  AssertEqual '  <#attempt>', getline(1)
  AssertEqual '      ', getline(2)
  AssertEqual '  </#attempt>', getline(3)
  bwipe!

" noexpandtab + tabstop==shiftwidth: body indent uses a real tab
Execute (CR body indent uses tab when noexpandtab):
  new
  setfiletype freemarker
  setlocal noexpandtab tabstop=4 shiftwidth=4 softtabstop=0
  call setline(1, ['<#attempt>', '</#attempt>'])
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  set virtualedit&
  AssertEqual '<#attempt>', getline(1)
  AssertEqual "\t", getline(2)
  AssertEqual '</#attempt>', getline(3)
  bwipe!

" coverage: ftplugin.auto_close_cr_one_closer
" AC4: Enter on blank body between open and close → no extra closer
Execute (CR on blank body between pair does not add closer):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, ['<#if x>', '', '</#if>'])
  call cursor(2, 1)
  call feedkeys("i\<CR>\<Esc>", 'xt')
  AssertEqual 1, len(filter(getline(1, '$'), 'v:val =~# "</#if>"'))
  Assert join(getline(1, '$'), "\n") !~# '</#if>\n</#if>'
  bwipe!

" coverage: ftplugin.auto_close_cr
" AC6: short assign does not auto-close on Enter
Execute (CR after short assign does not insert closer):
  new
  setfiletype freemarker
  setlocal shiftwidth=4 expandtab
  call setline(1, '<#assign x = 1>')
  call feedkeys("A\<CR>\<Esc>", 'xt')
  AssertEqual '<#assign x = 1>', getline(1)
  Assert join(getline(1, '$'), "\n") !~# '</#assign>'
  bwipe!

" coverage: ftplugin.auto_close_after_bracket
" 1) Generate when unclosed open at EOL
Execute (after_bracket generates closer for unclosed open at EOL):
  new
  setfiletype freemarker
  call setline(1, '<#list 1..3 as i>')
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  let keys = ftl_dev#close#after_bracket('>')
  set virtualedit&
  Assert keys =~# '</#list>'
  bwipe!

" coverage: ftplugin.auto_close_after_bracket
" 2) Skip same-line closer (fast-path)
Execute (after_bracket skips when closer already follows):
  new
  setfiletype freemarker
  call setline(1, '<#if x></#if>')
  " Insert-mode position after open `>` (before same-line closer)
  call cursor(1, strlen('<#if x>') + 1)
  AssertEqual '', ftl_dev#close#after_bracket('>')
  bwipe!

" coverage: ftplugin.auto_close_after_bracket
" 3) Skip when matching closer on next line (Bug A)
Execute (after_bracket skips when closer is on next line):
  new
  setfiletype freemarker
  call setline(1, ['<#list 1..3 as i>', '</#list>'])
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  AssertEqual '', ftl_dev#close#after_bracket('>')
  set virtualedit&
  " Type the open's `>` with closer already below — must not duplicate </#list>
  call setline(1, ['<#list 1..3 as i', '</#list>'])
  call cursor(1, strlen(getline(1)))
  call feedkeys("a>\<Esc>", 'xt')
  AssertEqual '<#list 1..3 as i>', getline(1)
  AssertEqual '</#list>', getline(2)
  AssertEqual 1, len(filter(getline(1, '$'), 'v:val =~# "</#list>"'))
  bwipe!

" coverage: ftplugin.auto_close_after_bracket
" 4) Skip when g:ftl_dev_auto_close = 0
Execute (after_bracket respects g:ftl_dev_auto_close off):
  new
  setfiletype freemarker
  let g:ftl_dev_auto_close = 0
  call setline(1, '<#list 1..3 as i>')
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  AssertEqual '', ftl_dev#close#after_bracket('>')
  set virtualedit&
  unlet g:ftl_dev_auto_close
  bwipe!

" coverage: ftplugin.auto_close_after_bracket
" 5) Square: skip when [/#list] follows on next line
Execute (after_bracket skips square closer on next line):
  new
  setfiletype freemarker
  call setline(1, ['[#list 1..3 as i]', '[/#list]'])
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  AssertEqual '', ftl_dev#close#after_bracket(']')
  set virtualedit&
  bwipe!

" coverage: ftplugin.auto_close_after_bracket
" 6) Non-pairable mid-block → no closer keys
Execute (after_bracket skips mid-block else):
  new
  setfiletype freemarker
  call setline(1, '<#else>')
  set virtualedit=onemore
  call cursor(1, strlen(getline(1)) + 1)
  AssertEqual '', ftl_dev#close#after_bracket('>')
  set virtualedit&
  bwipe!

" coverage: ftplugin.auto_close_cr_same_line
" Bug B: bare <#list>|</#list> Enter → open / body indent / closer
Execute (CR between bare same-line list pair splits with body indent):
