" coverage: ftdetect.ftl
Execute (ftdetect .ftl):
  new
  file ftl-dev-test.ftl
  doautocmd BufRead
  AssertEqual 'freemarker', &filetype
  bwipe!

" coverage: ftdetect.ftlh
Execute (ftdetect .ftlh):
  new
  file ftl-dev-test.ftlh
  doautocmd BufRead
  AssertEqual 'freemarker', &filetype
  bwipe!

" coverage: ftdetect.ftlx
Execute (ftdetect .ftlx):
  new
  file ftl-dev-test.ftlx
  doautocmd BufRead
  AssertEqual 'freemarker', &filetype
  bwipe!
